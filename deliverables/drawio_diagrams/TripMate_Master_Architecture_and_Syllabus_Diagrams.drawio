        <!-- Include relationships -->
        <mxCell id="inc1" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="edgeStyle=orthogonalEdgeStyle;dashed=1;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=1.2;fontColor=#38bdf8;fontSize=10;" edge="1" parent="sys_bound" source="uc2" target="uc1">
