        <mxCell id="act_auditor" value="&lt;b&gt;Security Auditor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#ef4444&quot;&gt;(Compliance &amp;amp; Logs)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#1e293b;strokeColor=#ef4444;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="520" width="50" height="100" as="geometry" />
        </mxCell>

        <!-- Connectors with explicit mxGeometry -->
