        <mxCell id="uc2" value="&lt;b&gt;Create &amp;amp; Delete Trip&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Set Budget, Dates, Privacy)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="80" y="140" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="&lt;b&gt;Invite &amp;amp; Delegate Roles&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Owner / Editor / Viewer RBAC)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="360" y="140" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="&lt;b&gt;Schedule Itinerary &amp;amp; Tasks&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Destinations &amp;amp; Day Planner)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0ea5e9;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="80" y="240" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="&lt;b&gt;Log Expenses &amp;amp; Fair Split&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Multi-User Payers &amp;amp; Ratios)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="360" y="240" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="&lt;b&gt;Reconcile Debt Matrix&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Zero-Sum Settlement Engine)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="220" y="340" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="&lt;b&gt;View Route &amp;amp; Expenses&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Read-Only Scoped Access)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#94a3b8;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="220" y="440" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="&lt;b&gt;Audit Security Events&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot; size=&quot;1&quot;&gt;(Append-Only Forensic Logs)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#ef4444;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="sys_bound">
          <mxGeometry x="220" y="550" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- Actors Left -->
        <mxCell id="act_owner" value="&lt;b&gt;Trip Owner&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#f59e0b&quot;&gt;(Full Admin Rights)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="50" height="100" as="geometry" />
        </mxCell>
        <mxCell id="act_editor" value="&lt;b&gt;Trip Editor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#0ea5e9&quot;&gt;(Contributor)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#1e293b;strokeColor=#0ea5e9;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="420" width="50" height="100" as="geometry" />
        </mxCell>

        <!-- Actors Right -->
        <mxCell id="act_viewer" value="&lt;b&gt;Trip Viewer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#94a3b8&quot;&gt;(Read-Only Role)&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#1e293b;strokeColor=#94a3b8;strokeWidth=2;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1030" y="220" width="50" height="100" as="geometry" />
