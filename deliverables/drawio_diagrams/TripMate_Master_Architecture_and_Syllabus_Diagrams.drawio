        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0ea5e9;strokeWidth=1.5;" edge="1" parent="1" source="act_editor" target="uc6">
          <mxGeometry relative="1" as="geometry" />
