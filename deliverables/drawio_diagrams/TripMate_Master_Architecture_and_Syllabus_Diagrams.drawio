          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- System Boundary -->
        <mxCell id="sys_bound" value="&lt;b&gt;SYSTEM BOUNDARY: TRIPMATE COLLABORATIVE ENGINE&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#38bdf8;fontSize=13;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
