<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" modified="2026-10-08T07:30:00.000Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.0.0 Chrome/120.0.6099.109 Electron/28.1.0 Safari/537.36" version="24.0.0" type="device">
  <diagram id="diag_2" name="Phase 3 - Scenario Analysis Model">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="900" background="#0f172a" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title_scen" value="&lt;b&gt;TripMate — Scenario Analysis Model (Trip Lifecycle &amp;amp; Access Delegation)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="precond" value="&lt;b&gt;PRECONDITIONS&lt;/b&gt;&lt;br/&gt;• User registered in database with Bcrypt hash&lt;br/&gt;• Valid JWT token issued via POST /api/auth/login&lt;br/&gt;• TLS 1.3 encrypted browser session active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="postcond" value="&lt;b&gt;POSTCONDITIONS&lt;/b&gt;&lt;br/&gt;• Trip saved with unique ID and owner role&lt;br/&gt;• Collaborators assigned scoped Editor/Viewer tokens&lt;br/&gt;• Tamper-evident audit log record committed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#10b981;strokeWidth=2;fontColor=#cbd5e1;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="80" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="step1" value="&lt;b&gt;Step 1: Authenticate&lt;/b&gt;&lt;br/&gt;User enters email/password.&lt;br/&gt;Receives signed JWT payload." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0ea5e9;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="210" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step2" value="&lt;b&gt;Step 2: Initialize Trip&lt;/b&gt;&lt;br/&gt;Defines Title, Dates, Budget,&lt;br/&gt;Currency and Privacy mode." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0ea5e9;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step3" value="&lt;b&gt;Step 3: Add Destinations&lt;/b&gt;&lt;br/&gt;Plots cities &amp;amp; arrival/departure&lt;br/&gt;time windows in sequence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0ea5e9;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="210" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="step4" value="&lt;b&gt;Step 4: Invite Members&lt;/b&gt;&lt;br/&gt;Enters collaborator email&lt;br/&gt;and assigns Editor or Viewer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="210" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dec1" value="&lt;b&gt;Collaborator&lt;br/&gt;Registered?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#f59e0b;strokeWidth=2;fontColor=#f59e0b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="825" y="340" width="130" height="90" as="geometry" />
        </mxCell>

        <mxCell id="branch_yes" value="&lt;b&gt;Active Linking&lt;/b&gt;&lt;br/&gt;User linked immediately.&lt;br/&gt;Trip appears in dashboard." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="480" width="170" height="65" as="geometry" />
        </mxCell>

        <mxCell id="branch_no" value="&lt;b&gt;Pending Invitation&lt;/b&gt;&lt;br/&gt;Saved with email key.&lt;br/&gt;Auto-activates on register." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="480" width="180" height="65" as="geometry" />
        </mxCell>

        <mxCell id="step5" value="&lt;b&gt;Step 5: Collaborative Actions&lt;/b&gt;&lt;br/&gt;• Editor adds tasks &amp;amp; expenses&lt;br/&gt;• Viewer accesses read-only view&lt;br/&gt;• Owner manages permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="480" width="230" height="75" as="geometry" />
        </mxCell>

        <mxCell id="step6" value="&lt;b&gt;Step 6: Financial Settlement&lt;/b&gt;&lt;br/&gt;Calculates multi-user split.&lt;br/&gt;Zero-sum ledger validation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#10b981;strokeWidth=2;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="480" width="210" height="75" as="geometry" />
        </mxCell>

        <!-- Connectors with mxGeometry -->
        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=2;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=2;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#38bdf8;strokeWidth=2;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" parent="1" source="step4" target="dec1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" value="[Yes]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;fontColor=#10b981;" edge="1" parent="1" source="dec1" target="branch_yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" value="[No]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#f59e0b;strokeWidth=2;fontColor=#f59e0b;" edge="1" parent="1" source="dec1" target="branch_no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="1" source="branch_yes" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="1" source="branch_no" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10b981;strokeWidth=2;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
